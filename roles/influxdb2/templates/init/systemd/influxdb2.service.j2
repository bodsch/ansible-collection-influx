# {{ ansible_managed }}

[Unit]
Description       = InfluxDB is an open-source, distributed, time series database
Documentation     = https://docs.influxdata.com/influxdb/
After             = network-online.target

[Service]
Type              = simple
Environment       = "GOMAXPROCS={{ ansible_facts.processor_vcpus | default(ansible_facts.processor_count) }}"
Environment       = MAX_OPEN_FILES=10000
Environment       = RESTART_ON_UPGRADE=true
EnvironmentFile   = {{ influxdb2_defaults_directory }}/influxdb2

User              = {{ influxdb2_system_user }}
Group             = {{ influxdb2_system_group }}

WorkingDirectory  = {{ influxdb2_storage_dir }}

ExecReload        = /bin/kill -HUP $MAINPID

# ExecStartPre      = /usr/bin/influxdb -config.file {{ influxdb2_config_dir }}/influxdb.yml -verify-config -log.level debug
ExecStartPre      = /bin/chown --recursive {{ influxdb2_system_user }}:{{ influxdb2_system_group }} {{ influxdb2_storage_dir }}
ExecStart         = /usr/bin/influxd $OPTIONS

LimitNOFILE       = 65000
SyslogIdentifier  = influxdb
Restart           = always
RestartSec        = 30

[Install]
Alias             = influxd.service
WantedBy          = multi-user.target
